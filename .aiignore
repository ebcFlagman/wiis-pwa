# .aiignore für das Competition Manager Projekt
# Syntax entspricht .gitignore (https://git-scm.com/docs/gitignore)

# --- Compiled Output & Build Artefakte ---
**/build/
**/dist/
**/out/
**/bin/
**/tmp/
**/.gradle/
**/node_modules/
**/.angular/cache/
**/target/
**/out-tsc/

# --- IDEs & Editors ---
.idea/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/
.vscode/
.nbproject/
*.swp
*.bak
*.tmp
.factorypath

# --- System & Logs ---
.DS_Store
Thumbs.db
desktop.ini
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
testem.log

# --- Umgebungsvariablen & Sensitive Daten ---
**/.env
**/.env.*
!**/.env.example
!**/.env.test.example
**/config/secrets/
**/*.p12
**/*.jks
**/*.key
**/*.pem

# --- Projekt-Spezifisches ---
/keycloak/
docker/volumes/
